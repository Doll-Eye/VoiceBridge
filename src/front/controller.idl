// NVDA controller wire declarations, from NV Access's nvdaController.idl.
// SPDX-License-Identifier: LGPL-2.1-only
// Copyright 2006-2026 NV Access Limited, Leonard de Ruijter, Ethin Probst.
// Changed for VoiceBridge, November 2026: only NvdaController and NvdaController3
// are kept, and a binding attribute was added for WIDL.

[uuid(DFF50B99-F7FD-4ca7-A82C-DAEB3E025295), version(1.0), implicit_handle(handle_t controllerBinding)]
interface NvdaController {
    error_status_t __stdcall testIfRunning();
    error_status_t __stdcall speakText([in, string] const wchar_t* text);
    error_status_t __stdcall cancelSpeech();
    error_status_t __stdcall brailleMessage([in, string] const wchar_t* message);
};

[uuid(019e4216-a9a1-7540-a217-e1a2d2793025), version(1.0), implicit_handle(handle_t controller3Binding)]
interface NvdaController3 {
    error_status_t __stdcall isSpeaking([out] boolean* speaking);
};
